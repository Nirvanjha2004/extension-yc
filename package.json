{
  "name": "launchvid-figma-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "LaunchVid export plugin for Figma",
  "scripts": {
    "clean": "rimraf src/plugin.js src/ui.html dist",
    "build:ts": "tsc -p tsconfig.json",
    "build:ui": "copyfiles -f ui.html src",
    "build": "npm run clean && npm run build:ts && npm run build:ui",
    "package": "npm run build && node scripts/package.mjs",
    "save-local": "node scripts/save-local.mjs"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.116.0",
    "copyfiles": "^2.4.1",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  }
}
